# Reemplaza los valores con las credenciales de tu cuenta de Mailtrap.
MAIL_API_KEY=REEMPLAZAR_CON_TU_TOKEN_DE_MAILTRAP
SENDER=remitente@ejemplo.com
MAIL_SANDBOX=true
MAIL_INBOX_ID=4903156
# Orígenes web permitidos por CORS, separados por comas, sin rutas ni barra final.
# En Render, configura esta variable en Environment del backend; el .env local no se publica.
# Ejemplo con web publicada y Expo local: https://app.example.com,http://localhost:8081
FRONTEND_URL=http://localhost:8081
PORT=3005
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=usuarios

# Development build: rn1://restablecer-contrasena
# Expo Go: exp://YOUR_LAN_IP:8081/--/restablecer-contrasena
# Web preview: http://localhost:8081/restablecer-contrasena
PASSWORD_RESET_URL=rn1://restablecer-contrasena
