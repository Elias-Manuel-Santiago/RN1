# Reemplaza los valores con las credenciales de tu cuenta de Mailtrap.
MAIL_API_KEY=REEMPLAZAR_CON_TU_TOKEN_DE_MAILTRAP
SENDER=remitente@ejemplo.com
MAIL_SANDBOX=true
MAIL_INBOX_ID=4903156
# URL pública del frontend usada para el enlace de recuperación de contraseña.
FRONTEND_URL=http://localhost:5173

# Expo web preview origins (comma-separated exact origins in production).
# FRONTEND_URL=http://localhost:8081
PORT=3005
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=usuarios

# Development build: rn1://restablecer-contrasena
# Expo Go: exp://YOUR_LAN_IP:8081/--/restablecer-contrasena
# Web preview: http://localhost:8081/restablecer-contrasena
PASSWORD_RESET_URL=rn1://restablecer-contrasena
