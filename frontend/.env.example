# Includes /api. Default URL for web and native (use HTTPS in production).
EXPO_PUBLIC_API_URL=http://localhost:3005/api
# Optional native override for local testing on a physical phone.
# Replace this example with your computer's LAN address; leave blank in production.
EXPO_PUBLIC_NATIVE_API_URL=http://192.168.1.100:3005/api

# Optional: a NEW Auth0 Native application (not R5's SPA Client ID).
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
